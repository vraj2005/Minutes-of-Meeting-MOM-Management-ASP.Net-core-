@model MOM_Project.Models.UserRegisterModel
@{
	Layout = "~/Views/Shared/_Layout_Login.cshtml";
	ViewData["Title"] = "Register";
}

<main>
 <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 col-md-10 col-lg-9 col-xl-8">
					<div class="card shadow-sm border-0 overflow-hidden">
						<div class="row g-0">
							<div class="col-lg-5 d-none d-lg-flex align-items-stretch">
								<div class="w-100 p-4 p-xl-5 text-white d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #0ea5e9 0%, #4154f1 55%, #6366f1 100%);">
									<div>
										<div class="d-flex align-items-center gap-2 mb-4">
											<i class="bi bi-shield-lock fs-3"></i>
											<div class="fw-bold fs-4">Create Account</div>
										</div>
										<h2 class="mb-3">Get started</h2>
										<p class="mb-0" style="opacity: .9;">Register to schedule meetings, manage staff and mark attendance faster.</p>
									</div>
									<div class="small" style="opacity: .85;">Already registered? Login anytime.</div>
								</div>
							</div>

							<div class="col-lg-7">
								<div class="card-body p-4 p-xl-5">
									<div class="mb-3">
										<h5 class="card-title fs-3 mb-1">Sign up</h5>
										<p class="text-muted mb-0">Fill in the details below.</p>
									</div>

									@if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
									{
										<div class="alert alert-danger">@errorMessage</div>
									}

									<form class="needs-validation" asp-action="Register" asp-controller="User" method="post">
										@Html.AntiForgeryToken()

										<div class="row g-3">
											<div class="col-12">
												<label class="form-label">Username</label>
												<input type="text" asp-for="UserName" class="form-control" placeholder="Choose a username" autocomplete="username" />
												<span asp-validation-for="UserName" class="text-danger"></span>
											</div>

											<div class="col-12 col-md-6">
												<label class="form-label">Mobile No</label>
												<input type="text" asp-for="MobileNo" class="form-control" placeholder="9876543210" inputmode="tel" autocomplete="tel" />
												<span asp-validation-for="MobileNo" class="text-danger"></span>
											</div>

											<div class="col-12 col-md-6">
												<label class="form-label">Email</label>
												<input type="email" asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
												<span asp-validation-for="Email" class="text-danger"></span>
											</div>

											<div class="col-12">
												<label class="form-label">Password</label>
												<input type="password" asp-for="Password" class="form-control" placeholder="Create a password" autocomplete="new-password" />
												<span asp-validation-for="Password" class="text-danger"></span>
											</div>

											<div class="col-12">
												<label class="form-label">Address</label>
												<textarea asp-for="Address" class="form-control" rows="2" placeholder="Optional"></textarea>
											</div>
										</div>

										<button class="btn btn-primary w-100 py-2 mt-3" type="submit">Create Account</button>

										<div class="text-center mt-3">
											<span class="text-muted">Already have an account?</span>
											<a class="ms-1" asp-action="Login" asp-controller="User">Login</a>
										</div>
									</form>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</main>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
