<!-- Add Venue Modal -->
<div class="modal fade" id="addVenueModal" tabindex="-1" aria-labelledby="addVenueModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addVenueModalLabel"><i class="bi bi-plus-circle me-2"></i>Add Venue</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addVenueForm">
                    <div class="mb-3">
                        <label for="venueName" class="form-label">Venue Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="venueName" placeholder="Enter venue name" required>
                        <div class="invalid-feedback">Please enter venue name.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" onclick="saveVenue()">
                    <i class="bi bi-check-circle me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Venue Modal -->
<div class="modal fade" id="editVenueModal" tabindex="-1" aria-labelledby="editVenueModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="editVenueModalLabel"><i class="bi bi-pencil me-2"></i>Edit Venue</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editVenueForm">
                    <input type="hidden" id="editVenueId">
                    <div class="mb-3">
                        <label for="editVenueName" class="form-label">Venue Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editVenueName" placeholder="Enter venue name" required>
                        <div class="invalid-feedback">Please enter venue name.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-info" onclick="updateVenue()">
                    <i class="bi bi-check-circle me-1"></i>Update
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Venue Modal -->
<div class="modal fade" id="deleteVenueModal" tabindex="-1" aria-labelledby="deleteVenueModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteVenueModalLabel"><i class="bi bi-trash me-2"></i>Delete Venue</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteVenueId">
                <p class="mb-0">Are you sure you want to delete the venue: <strong id="deleteVenueName"></strong>?</p>
                <p class="text-danger mt-2 mb-0"><small><i class="bi bi-exclamation-triangle me-1"></i>This action cannot be undone.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteVenue()">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .table thead th {
        background-color: #f6f9ff;
        color: #012970;
        font-weight: 600;
        border-bottom: 2px solid #ebeef4;
        padding: 15px;
    }

    .table tbody tr:hover {
        background-color: #f9fbff;
        transition: background-color 0.2s ease;
    }

    .table tbody td {
        padding: 12px 15px;
        border-bottom: 1px solid #ebeef4;
        vertical-align: middle;
    }

    .fw-500 {
        font-weight: 500;
        color: #012970;
    }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
        color: #fff;
    }

    .btn-info:hover {
        background-color: #138496;
        border-color: #117a8b;
        color: #fff;
    }

    .btn-primary {
        background-color: #4154f1;
        border-color: #4154f1;
    }

    .btn-primary:hover {
        background-color: #3144d9;
        border-color: #2836c0;
    }

    .modal-header {
        border-radius: 0;
    }

    .form-label {
        font-weight: 600;
        color: #012970;
    }
</style>

<script>
    function editVenue(id, name) {
        document.getElementById('editVenueId').value = id;
        document.getElementById('editVenueName').value = name;
    }

    function deleteVenue(id, name) {
        document.getElementById('deleteVenueId').value = id;
        document.getElementById('deleteVenueName').textContent = name;
    }

    function saveVenue() {
        var name = document.getElementById('venueName').value;
        if (name.trim() === '') {
            document.getElementById('venueName').classList.add('is-invalid');
            return;
        }
        alert('Venue "' + name + '" added successfully!');
        var modal = bootstrap.Modal.getInstance(document.getElementById('addVenueModal'));
        modal.hide();
        document.getElementById('venueName').value = '';
    }

    function updateVenue() {
        var name = document.getElementById('editVenueName').value;
        if (name.trim() === '') {
            document.getElementById('editVenueName').classList.add('is-invalid');
            return;
        }
        alert('Venue updated successfully!');
        var modal = bootstrap.Modal.getInstance(document.getElementById('editVenueModal'));
        modal.hide();
    }

    function confirmDeleteVenue() {
        var name = document.getElementById('deleteVenueName').textContent;
        alert('Venue "' + name + '" deleted successfully!');
        var modal = bootstrap.Modal.getInstance(document.getElementById('deleteVenueModal'));
        modal.hide();
    }
</script>
