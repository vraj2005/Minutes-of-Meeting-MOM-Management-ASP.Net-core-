@model IEnumerable<MOM_Project.Models.Meeting>

@{
    ViewData["Title"] = "Meetings";
}

<div class="pagetitle">
    <h1>Meetings</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item">Meeting Management</li>
            <li class="breadcrumb-item active">All Meetings</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">Meetings List</h5>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addMeetingModal">
                            <i class="bi bi-plus-circle"></i> Schedule Meeting
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 60px;"><b>#</b></th>
                                    <th><b>Meeting Description</b></th>
                                    <th class="text-center"><b>Date & Time</b></th>
                                    <th><b>Venue</b></th>
                                    <th><b>Type</b></th>
                                    <th><b>Department</b></th>
                                    <th class="text-center"><b>Status</b></th>
                                    <th class="text-center" style="width: 120px;"><b>Actions</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@item.MeetingID</td>
                                        <td><span class="fw-500">@item.MeetingDescription</span></td>
                                        <td class="text-center">@item.MeetingDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@item.MeetingVenueID</td>
                                        <td>@item.MeetingTypeID</td>
                                        <td>@item.DepartmentID</td>
                                        <td class="text-center">
                                            <span class="badge @(item.Status == "Scheduled" ? "bg-success" : "bg-warning")">@item.Status</span>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-info" title="Edit" data-bs-toggle="modal" data-bs-target="#editMeetingModal" onclick="editMeeting(@item.MeetingID, '@item.MeetingDescription', '@item.MeetingDate.ToString("yyyy-MM-ddTHH:mm")', @item.MeetingVenueID, @item.MeetingTypeID, @item.DepartmentID, '@item.DocumentPath')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteMeetingModal" onclick="deleteMeeting(@item.MeetingID, '@item.MeetingDescription')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add Meeting Modal -->
<div class="modal fade" id="addMeetingModal" tabindex="-1" aria-labelledby="addMeetingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addMeetingModalLabel"><i class="bi bi-calendar-plus me-2"></i>Schedule New Meeting</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addMeetingForm">
                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label for="meetingDescription" class="form-label">Meeting Description <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="meetingDescription" placeholder="Enter meeting description" required>
                            <div class="invalid-feedback">Please enter meeting description.</div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="meetingDate" class="form-label">Date & Time <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" id="meetingDate" required>
                            <div class="invalid-feedback">Please select date and time.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="meetingVenueId" class="form-label">Venue <span class="text-danger">*</span></label>
                            <select class="form-select" id="meetingVenueId" required>
                                <option value="">Select Venue</option>
                                <option value="1">Conference Room A</option>
                                <option value="2">Conference Room B</option>
                                <option value="3">Board Room</option>
                                <option value="4">Main Auditorium</option>
                                <option value="5">Training Room</option>
                                <option value="6">Virtual Meeting Room</option>
                            </select>
                            <div class="invalid-feedback">Please select a venue.</div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="meetingTypeId" class="form-label">Meeting Type <span class="text-danger">*</span></label>
                            <select class="form-select" id="meetingTypeId" required>
                                <option value="">Select Meeting Type</option>
                                <option value="1">Regular Meeting</option>
                                <option value="2">Board Meeting</option>
                                <option value="3">Project Review</option>
                                <option value="4">Town Hall</option>
                                <option value="5">Training Session</option>
                            </select>
                            <div class="invalid-feedback">Please select meeting type.</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="meetingDepartmentId" class="form-label">Department <span class="text-danger">*</span></label>
                            <select class="form-select" id="meetingDepartmentId" required>
                                <option value="">Select Department</option>
                                <option value="1">Human Resources</option>
                                <option value="2">Finance</option>
                                <option value="3">Information Technology</option>
                                <option value="4">Operations</option>
                                <option value="5">Marketing</option>
                            </select>
                            <div class="invalid-feedback">Please select department.</div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="documentPath" class="form-label">Document Path</label>
                        <input type="text" class="form-control" id="documentPath" placeholder="Enter document path (optional)">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" onclick="saveMeeting()">
                    <i class="bi bi-check-circle me-1"></i>Schedule
                </button>
            </div>
        </div>
    </div>
</div>

