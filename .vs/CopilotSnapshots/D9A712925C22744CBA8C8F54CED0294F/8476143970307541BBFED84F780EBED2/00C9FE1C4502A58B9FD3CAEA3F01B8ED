@{
    ViewData["Title"] = "Departments";
}

<div class="pagetitle">
    <h1>Departments</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item">Master Data</li>
            <li class="breadcrumb-item active">Departments</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">Department List</h5>
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addDepartmentModal">
                            <i class="bi bi-plus-circle"></i> Add Department
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 60px;"><b>#</b></th>
                                    <th><b>Department Name</b></th>
                                    <th class="text-center" style="width: 150px;"><b>Created</b></th>
                                    <th class="text-center" style="width: 150px;"><b>Modified</b></th>
                                    <th class="text-center" style="width: 120px;"><b>Actions</b></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center fw-bold">1</td>
                                    <td><span class="fw-500">Human Resources</span></td>
                                    <td class="text-center">01/01/2026</td>
                                    <td class="text-center">05/01/2026</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-info" title="Edit" data-bs-toggle="modal" data-bs-target="#editDepartmentModal" onclick="editDepartment(1, 'Human Resources')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteDepartmentModal" onclick="deleteDepartment(1, 'Human Resources')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-bold">2</td>
                                    <td><span class="fw-500">Finance</span></td>
                                    <td class="text-center">02/01/2026</td>
                                    <td class="text-center">04/01/2026</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-info" title="Edit" data-bs-toggle="modal" data-bs-target="#editDepartmentModal" onclick="editDepartment(2, 'Finance')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteDepartmentModal" onclick="deleteDepartment(2, 'Finance')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-bold">3</td>
                                    <td><span class="fw-500">Information Technology</span></td>
                                    <td class="text-center">03/01/2026</td>
                                    <td class="text-center">06/01/2026</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-info" title="Edit" data-bs-toggle="modal" data-bs-target="#editDepartmentModal" onclick="editDepartment(3, 'Information Technology')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteDepartmentModal" onclick="deleteDepartment(3, 'Information Technology')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-bold">4</td>
                                    <td><span class="fw-500">Operations</span></td>
                                    <td class="text-center">04/01/2026</td>
                                    <td class="text-center">05/01/2026</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-info" title="Edit" data-bs-toggle="modal" data-bs-target="#editDepartmentModal" onclick="editDepartment(4, 'Operations')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteDepartmentModal" onclick="deleteDepartment(4, 'Operations')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center fw-bold">5</td>
                                    <td><span class="fw-500">Marketing</span></td>
                                    <td class="text-center">05/01/2026</td>
                                    <td class="text-center">06/01/2026</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-info" title="Edit" data-bs-toggle="modal" data-bs-target="#editDepartmentModal" onclick="editDepartment(5, 'Marketing')">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteDepartmentModal" onclick="deleteDepartment(5, 'Marketing')">
                                            <i class="bi bi-trash"></i>
