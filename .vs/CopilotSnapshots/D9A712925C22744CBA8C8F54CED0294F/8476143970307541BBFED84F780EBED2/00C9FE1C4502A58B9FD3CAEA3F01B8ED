                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add Department Modal -->
<div class="modal fade" id="addDepartmentModal" tabindex="-1" aria-labelledby="addDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addDepartmentModalLabel"><i class="bi bi-plus-circle me-2"></i>Add Department</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="addDepartmentForm">
                    <div class="mb-3">
                        <label for="departmentName" class="form-label">Department Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="departmentName" placeholder="Enter department name" required>
                        <div class="invalid-feedback">Please enter department name.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-primary" onclick="saveDepartment()">
                    <i class="bi bi-check-circle me-1"></i>Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Department Modal -->
<div class="modal fade" id="editDepartmentModal" tabindex="-1" aria-labelledby="editDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="editDepartmentModalLabel"><i class="bi bi-pencil me-2"></i>Edit Department</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editDepartmentForm">
                    <input type="hidden" id="editDepartmentId">
                    <div class="mb-3">
                        <label for="editDepartmentName" class="form-label">Department Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editDepartmentName" placeholder="Enter department name" required>
                        <div class="invalid-feedback">Please enter department name.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-info" onclick="updateDepartment()">
                    <i class="bi bi-check-circle me-1"></i>Update
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Department Modal -->
<div class="modal fade" id="deleteDepartmentModal" tabindex="-1" aria-labelledby="deleteDepartmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteDepartmentModalLabel"><i class="bi bi-trash me-2"></i>Delete Department</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteDepartmentId">
                <p class="mb-0">Are you sure you want to delete the department: <strong id="deleteDepartmentName"></strong>?</p>
                <p class="text-danger mt-2 mb-0"><small><i class="bi bi-exclamation-triangle me-1"></i>This action cannot be undone.</small></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteDepartment()">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .table thead th {
        background-color: #f6f9ff;
        color: #012970;
        font-weight: 600;
        border-bottom: 2px solid #ebeef4;
        padding: 15px;
    }

    .table tbody tr:hover {
        background-color: #f9fbff;
        transition: background-color 0.2s ease;
    }

    .table tbody td {
        padding: 12px 15px;
        border-bottom: 1px solid #ebeef4;
        vertical-align: middle;
    }

    .fw-500 {
        font-weight: 500;
        color: #012970;
    }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
        color: #fff;
    }

    .btn-info:hover {
        background-color: #138496;
        border-color: #117a8b;
        color: #fff;
    }

    .btn-primary {
        background-color: #4154f1;
        border-color: #4154f1;
    }

    .btn-primary:hover {
        background-color: #3144d9;
        border-color: #2836c0;
    }

    .modal-header {
        border-radius: 0;
    }

    .form-label {
        font-weight: 600;
        color: #012970;
    }
</style>

<script>
    function editDepartment(id, name) {
        document.getElementById('editDepartmentId').value = id;
        document.getElementById('editDepartmentName').value = name;
    }

    function deleteDepartment(id, name) {
        document.getElementById('deleteDepartmentId').value = id;
        document.getElementById('deleteDepartmentName').textContent = name;
    }

    function saveDepartment() {
        var name = document.getElementById('departmentName').value;
        if (name.trim() === '') {
            document.getElementById('departmentName').classList.add('is-invalid');
            return;
        }
        // Static: Just close modal (would submit to server in real app)
        alert('Department "' + name + '" added successfully!');
        var modal = bootstrap.Modal.getInstance(document.getElementById('addDepartmentModal'));
        modal.hide();
        document.getElementById('departmentName').value = '';
    }

    function updateDepartment() {
        var name = document.getElementById('editDepartmentName').value;
        if (name.trim() === '') {
            document.getElementById('editDepartmentName').classList.add('is-invalid');
            return;
        }
        // Static: Just close modal (would submit to server in real app)
        alert('Department updated successfully!');
        var modal = bootstrap.Modal.getInstance(document.getElementById('editDepartmentModal'));
        modal.hide();
    }

    function confirmDeleteDepartment() {
        var name = document.getElementById('deleteDepartmentName').textContent;
        // Static: Just close modal (would submit to server in real app)
        alert('Department "' + name + '" deleted successfully!');
        var modal = bootstrap.Modal.getInstance(document.getElementById('deleteDepartmentModal'));
        modal.hide();
    }
</script>
