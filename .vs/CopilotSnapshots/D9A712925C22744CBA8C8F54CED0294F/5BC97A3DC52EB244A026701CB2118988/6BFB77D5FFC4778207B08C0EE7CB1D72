using Microsoft.AspNetCore.Mvc;
using MOM_Project.Models;

namespace MOM_Project.Controllers
{
    public class MeetingsController : Controller
    {
        // Static data for demonstration
        private static List<Meeting> meetings = new List<Meeting>
        {
            new Meeting { MeetingID = 1, MeetingDate = DateTime.Now.AddDays(-5), MeetingVenueID = 1, MeetingTypeID = 1, DepartmentID = 1, MeetingDescription = "Q4 Planning", Created = DateTime.Now.AddDays(-5), Modified = DateTime.Now.AddDays(-5), IsCancelled = false },
            new Meeting { MeetingID = 2, MeetingDate = DateTime.Now.AddDays(-2), MeetingVenueID = 2, MeetingTypeID = 2, DepartmentID = 2, MeetingDescription = "Budget Review", Created = DateTime.Now.AddDays(-2), Modified = DateTime.Now.AddDays(-2), IsCancelled = false },
            new Meeting { MeetingID = 3, MeetingDate = DateTime.Now.AddDays(3), MeetingVenueID = 3, MeetingTypeID = 3, DepartmentID = 3, MeetingDescription = "Project Status", Created = DateTime.Now.AddDays(-1), Modified = DateTime.Now.AddDays(-1), IsCancelled = false },
            new Meeting { MeetingID = 4, MeetingDate = DateTime.Now.AddDays(7), MeetingVenueID = 4, MeetingTypeID = 4, DepartmentID = 4, MeetingDescription = "Team Building", Created = DateTime.Now, Modified = DateTime.Now, IsCancelled = false }
        };

        public IActionResult Index()
        {
            return View(meetings);
        }

        public IActionResult Details(int id)
        {
            var meeting = meetings.FirstOrDefault(m => m.MeetingID == id);
            if (meeting == null)
            {
                return NotFound();
            }
            return View(meeting);
        }

        public IActionResult Create()
        {
            return View();
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public IActionResult Create([Bind("MeetingDate,MeetingVenueID,MeetingTypeID,DepartmentID,MeetingDescription,DocumentPath")] Meeting meeting)
        {
            if (ModelState.IsValid)
            {
                meeting.MeetingID = meetings.Max(m => m.MeetingID) + 1;
                meeting.Created = DateTime.Now;
                meeting.Modified = DateTime.Now;
                meeting.IsCancelled = false;
                meetings.Add(meeting);
                return RedirectToAction(nameof(Index));
            }
            return View(meeting);
        }

        public IActionResult Edit(int id)
        {
            var meeting = meetings.FirstOrDefault(m => m.MeetingID == id);
            if (meeting == null)
            {
                return NotFound();
            }
            return View(meeting);
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public IActionResult Edit(int id, [Bind("MeetingID,MeetingDate,MeetingVenueID,MeetingTypeID,DepartmentID,MeetingDescription,DocumentPath,Created")] Meeting meeting)
        {
            if (id != meeting.MeetingID)
            {
                return NotFound();
            }

            if (ModelState.IsValid)
            {
                var existingMeeting = meetings.FirstOrDefault(m => m.MeetingID == id);
                if (existingMeeting != null)
                {
                    existingMeeting.MeetingDate = meeting.MeetingDate;
                    existingMeeting.MeetingVenueID = meeting.MeetingVenueID;
                    existingMeeting.MeetingTypeID = meeting.MeetingTypeID;
                    existingMeeting.DepartmentID = meeting.DepartmentID;
                    existingMeeting.MeetingDescription = meeting.MeetingDescription;
                    existingMeeting.DocumentPath = meeting.DocumentPath;
                    existingMeeting.Modified = DateTime.Now;
                }
                return RedirectToAction(nameof(Index));
            }
            return View(meeting);
        }

        public IActionResult Delete(int id)
        {
            var meeting = meetings.FirstOrDefault(m => m.MeetingID == id);
            if (meeting == null)
            {
                return NotFound();
            }
            return View(meeting);
        }

        [HttpPost, ActionName("Delete")]
        [ValidateAntiForgeryToken]
        public IActionResult DeleteConfirmed(int id)
        {
            var meeting = meetings.FirstOrDefault(m => m.MeetingID == id);
            if (meeting != null)
            {
                meetings.Remove(meeting);
            }
            return RedirectToAction(nameof(Index));
        }
    }
}
