@model IEnumerable<MOM_Project.Models.MeetingVenue>

<div class="pagetitle">
    <h1>Meeting Venues</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item">Master Data</li>
            <li class="breadcrumb-item active">Meeting Venues</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="card-title mb-0">Meeting Venues List</h5>
                        <a asp-controller="MeetingVenue" asp-action="Create" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-circle"></i> Add Venue
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover datatable">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 50px;">
                                        <b>#</b>
                                    </th>
                                    <th>
                                        <b>Venue Name</b>
                                    </th>
                                    <th class="text-center" style="width: 150px;">
                                        <b>Actions</b>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center fw-bold">@item.MeetingVenueID</td>
                                        <td>
                                            <span class="fw-500">@item.MeetingVenueName</span>
                                        </td>
                                        <td class="text-center">
                                            <a asp-controller="MeetingVenue" asp-action="Edit" asp-route-id="@item.MeetingVenueID" class="btn btn-sm btn-info" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-controller="MeetingVenue" asp-action="Delete" asp-route-id="@item.MeetingVenueID" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .table thead th {
        background-color: #f6f9ff;
        color: #012970;
        font-weight: 600;
        border-bottom: 2px solid #ebeef4;
        padding: 15px;
    }

    .table tbody tr:hover {
        background-color: #f9fbff;
        transition: background-color 0.2s ease;
    }

    .table tbody td {
        padding: 12px 15px;
        border-bottom: 1px solid #ebeef4;
        vertical-align: middle;
    }

    .fw-500 {
        font-weight: 500;
        color: #012970;
    }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
        color: #fff;
    }

    .btn-info:hover {
        background-color: #138496;
        border-color: #117a8b;
    }

    .btn-primary {
        background-color: #4154f1;
        border-color: #4154f1;
    }

    .btn-primary:hover {
        background-color: #3144d9;
        border-color: #2836c0;
    }

    .table-responsive {
        overflow-x: auto;
    }
</style>
