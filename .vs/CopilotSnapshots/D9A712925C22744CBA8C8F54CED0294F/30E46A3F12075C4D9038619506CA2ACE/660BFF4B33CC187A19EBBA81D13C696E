using Microsoft.AspNetCore.Mvc;
using MOM_Project.Models;

namespace MOM_Project.Controllers
{
    public class MeetingVenueController : Controller
    {
        // Static data for demonstration
        private static List<MeetingVenue> meetingVenues = new List<MeetingVenue>
        {
            new MeetingVenue { MeetingVenueID = 1, MeetingVenueName = "Conference Room A", Created = DateTime.Now.AddDays(-10), Modified = DateTime.Now.AddDays(-10) },
            new MeetingVenue { MeetingVenueID = 2, MeetingVenueName = "Conference Room B", Created = DateTime.Now.AddDays(-8), Modified = DateTime.Now.AddDays(-8) },
            new MeetingVenue { MeetingVenueID = 3, MeetingVenueName = "Board Room", Created = DateTime.Now.AddDays(-5), Modified = DateTime.Now.AddDays(-5) },
            new MeetingVenue { MeetingVenueID = 4, MeetingVenueName = "Main Auditorium", Created = DateTime.Now.AddDays(-2), Modified = DateTime.Now.AddDays(-2) }
        };

        public IActionResult Index()
        {
            return View(meetingVenues);
        }

        public IActionResult Details(int id)
        {
            var venue = meetingVenues.FirstOrDefault(m => m.MeetingVenueID == id);
            if (venue == null)
            {
                return NotFound();
            }
            return View(venue);
        }

        public IActionResult Create()
        {
            return View();
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public IActionResult Create([Bind("MeetingVenueName")] MeetingVenue venue)
        {
            if (ModelState.IsValid)
            {
                venue.MeetingVenueID = meetingVenues.Max(m => m.MeetingVenueID) + 1;
                venue.Created = DateTime.Now;
                venue.Modified = DateTime.Now;
                meetingVenues.Add(venue);
                return RedirectToAction(nameof(Index));
            }
            return View(venue);
        }

        public IActionResult Edit(int id)
        {
            var venue = meetingVenues.FirstOrDefault(m => m.MeetingVenueID == id);
            if (venue == null)
            {
                return NotFound();
            }
            return View(venue);
        }

        [HttpPost]
        [ValidateAntiForgeryToken]
        public IActionResult Edit(int id, [Bind("MeetingVenueID,MeetingVenueName,Created")] MeetingVenue venue)
        {
            if (id != venue.MeetingVenueID)
            {
                return NotFound();
            }

            if (ModelState.IsValid)
            {
                var existingVenue = meetingVenues.FirstOrDefault(m => m.MeetingVenueID == id);
                if (existingVenue != null)
                {
                    existingVenue.MeetingVenueName = venue.MeetingVenueName;
                    existingVenue.Modified = DateTime.Now;
                }
                return RedirectToAction(nameof(Index));
            }
            return View(venue);
        }

        public IActionResult Delete(int id)
        {
            var venue = meetingVenues.FirstOrDefault(m => m.MeetingVenueID == id);
            if (venue == null)
            {
                return NotFound();
            }
            return View(venue);
        }

        [HttpPost, ActionName("Delete")]
        [ValidateAntiForgeryToken]
        public IActionResult DeleteConfirmed(int id)
        {
            var venue = meetingVenues.FirstOrDefault(m => m.MeetingVenueID == id);
            if (venue != null)
            {
                meetingVenues.Remove(venue);
            }
            return RedirectToAction(nameof(Index));
        }
    }
}
