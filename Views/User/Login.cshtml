@model MOM_Project.Models.UserLoginModel
@{
	Layout = "~/Views/Shared/_Layout_Login.cshtml";
	ViewData["Title"] = "Login";
}

<main>
 <section class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 col-md-10 col-lg-8 col-xl-7">
                   <div class="card mom-glass mom-card border-0 overflow-hidden">
						<div class="row g-0">
							<div class="col-lg-6 d-none d-lg-flex align-items-stretch">
								<div class="w-100 p-4 p-xl-5 text-white d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #4154f1 0%, #1b74e4 40%, #0ea5e9 100%);">
									<div>
										<div class="d-flex align-items-center gap-2 mb-4">
											<i class="bi bi-journal-check fs-3"></i>
											<div class="fw-bold fs-4">MOM Management</div>
										</div>
										<h2 class="mb-3">Welcome back</h2>
										<p class="mb-0" style="opacity: .9;">Manage meetings, attendance and master data from one place.</p>
									</div>
									<div class="small" style="opacity: .85;">© @DateTime.Now.Year MOM Management System</div>
								</div>
							</div>

							<div class="col-lg-6">
								<div class="card-body p-4 p-xl-5">
									<div class="mb-3">
										<h5 class="card-title fs-3 mb-1">Sign in</h5>
                                      <p class="mom-muted mb-0">Enter your credentials to continue.</p>
									</div>

									@if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
									{
										<div class="alert alert-danger">@errorMessage</div>
									}
									@if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
									{
										<div class="alert alert-success">@successMessage</div>
									}

									<form class="needs-validation" asp-action="Login" asp-controller="User" method="post">
										@Html.AntiForgeryToken()

										<div class="mb-3">
											<label class="form-label">Username</label>
											<div class="input-group">
												<span class="input-group-text"><i class="bi bi-person"></i></span>
												<input type="text" asp-for="UserName" class="form-control" placeholder="Enter username" autocomplete="username" />
											</div>
											<span asp-validation-for="UserName" class="text-danger"></span>
										</div>

										<div class="mb-3">
											<label class="form-label">Password</label>
											<div class="input-group">
												<span class="input-group-text"><i class="bi bi-lock"></i></span>
												<input type="password" asp-for="Password" class="form-control" placeholder="Enter password" autocomplete="current-password" />
											</div>
											<span asp-validation-for="Password" class="text-danger"></span>
										</div>

										<button class="btn btn-primary w-100 py-2" type="submit">Login</button>

										<div class="text-center mt-3">
											<span class="text-muted">Don’t have an account?</span>
											<a class="ms-1" asp-action="Register" asp-controller="User">Create one</a>
										</div>
									</form>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</main>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
